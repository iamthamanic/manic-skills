# Project config for verify-ui and agent pipeline
# Generated by /project-setup — adjust navigation and paths as the product grows

appRoot: {{APP_ROOT}}

devCommand: npm run dev
devUrl: {{DEV_URL}}

checksCommand: npm run checks
e2eCommand: npm run test:e2e

styleguide: {{STYLEGUIDE_PATH}}
designDir: .qa/design
acceptanceDir: .qa/acceptance
evidenceDir: .qa/evidence

locale: {{LOCALE}}

# Secure-by-Default — written by @project-setup into AGENTS.md + .qa/edge-cases.md.
# @ecc-check / @audit-changes / @review-ticket / @test-gate read this to know the checklist is active.
security:
  checklist: secure-by-default   # "secure-by-default" | "disabled" (legacy projects)

# @typed-strict — programming languages (NOT UI locale). Auto-filled by project-setup.
# Override or extend; audit appends newly detected languages, never shrinks silently.
typedStrict:
  languages: {{TYPED_STRICT_LANGUAGES}}

# @test-gate — deterministic tools/scripts (no AI review). See ~/.claude/skills/test-gate/
testGate:
  profile: auto                  # auto | next | vite-react | express-prisma | monorepo | …
  depthDefault: standard         # quick | standard | full
  runner: scripts                # scripts | shim (shim => noAiReview only)
  always:
    - typedStrict
    - secureByDefault
    - rgSecretsDiff
  never:
    - aiReview
    - explanationCheck
    - fallow
    - updateReadme
    - mutation

# @issue-contract — canonical GitHub issue template (global default).
# Skills resolve .qa/issue-template.md (project override) first, then the global file.
issueContract:
  template: global               # "global" | path to project override (e.g. .qa/issue-template.md)
  labels: [P0, P1, P2, needs-design]
  maxAcceptanceBullets: 5
  runtimeAxes: []                # e.g. [Local, Cloud session, Appwrite Functions]
  securitySection: true
  locale: {{LOCALE}}

viewports:
  - name: mobile
    width: 390
    height: 844
  - name: desktop
    width: 1280
    height: 720

# Main navigation labels for smoke tests — fill when UI routes exist
navigation: []
